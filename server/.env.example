# ─── Kristy server config ───
PORT=3001

# Anthropic — Kristy runs entirely on Haiku
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# USDA FoodData Central — real macros for typed meal logging (free).
# Get a key: https://fdc.nal.usda.gov/api-key-signup.html
# If unset, typed meals gracefully fall back to Claude macro estimates.
USDA_API_KEY=

# Supabase — server uses the SERVICE ROLE key (trusted, bypasses RLS).
# Never expose the service role key to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated origins allowed to call the API (the Vite dev server, your prod domain)
CLIENT_ORIGIN=http://localhost:5173

# Optional — guards the all-users weekly summary cron run (POST /api/weekly-summary
# with an x-cron-secret header). Leave blank to disable the all-users trigger.
CRON_SECRET=

# Optional — turns on the INTERNAL growth view (the counter's authoring backlog and
# the scanner's coverage) at /api/internal/growth and /api/internal/growth.html.
#   • LEAVE BLANK to keep it off. Blank means every internal path 404s — the view is
#     opt-in per environment rather than shipped open.
#   • Must be at least 24 characters. Anything shorter is treated as unset and warned
#     about, because this endpoint is reachable from anywhere.
#   • Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   • It can be passed as `Authorization: Bearer <token>` or, so the HTML view opens in
#     a browser, as `?token=<token>`. The query form lands in server logs and browser
#     history — rotate it rather than treating it as permanent.
# The view reads ONLY aggregate tables (products and questions, never people).
INTERNAL_DASHBOARD_TOKEN=

# ─── Stripe (web billing) ───
# The FIRST payment provider. In the Stripe dashboard create ONE product
# ("Kristy Membership") with TWO recurring prices, then paste their price ids
# (they look like price_xxx) into the two _PRICE_ vars below:
#   • Monthly — $7.99 USD, recurring monthly   → STRIPE_PRICE_MONTHLY
#   • Annual  — $59.99 USD, recurring yearly    → STRIPE_PRICE_ANNUAL
# Display prices live in client/src/lib/pricing.js — keep them in sync with these.
# Enable Stripe Tax to add tax on top at checkout — don't bake tax into the price.
# The webhook secret comes from the endpoint you create for /api/stripe/webhook.
# Leave all four blank to run without billing (trial + free features still work;
# the billing endpoints return a clean 503, and checkout logs which var is unset).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ─── Phone sign-in ───
# NOTHING GOES HERE. Phone OTP runs on Supabase's BUILT-IN Twilio provider,
# configured entirely in the Supabase dashboard (Auth → Providers → Phone →
# Twilio: Account SID, Auth Token, Message Service SID). Supabase mints the code
# AND delivers it, so this server is not in the path and needs no SMS env at all.
#
# A custom Send SMS Hook once routed delivery through Bird and its vars lived here.
# That approach was abandoned; the code and the vars were deleted 2026-08-02. Do not
# add a delivery hook back without a reason the dashboard cannot meet.
